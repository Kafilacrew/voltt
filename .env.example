# Frontend Public Environment Variables (Vite)
# Note: Variables prefixed with VITE_ are exposed to the browser client.
# DO NOT place backend secrets, private keys, or secret tokens here.

VITE_API_BASE_URL=http://localhost:5000

# Supabase Public Client Credentials (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key_here
